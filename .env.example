# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/fusion-fuel-boost

# Auth.js / NextAuth v5
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (used for Stripe redirects and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (Gmail / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fusionfuelboostco@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Fusion Fuel & Boost Co
SMTP_FROM_EMAIL=fusionfuelboostco@gmail.com
CONTACT_TO_EMAIL=fusionfuelboostco@gmail.com

# CRM integration layer
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Uploads
UPLOAD_MAX_SIZE_MB=5
